NODE_ENV=test

# Neon/Vercel provides this in deployed environments. Docker uses the POSTGRES_* values below.
DATABASE_URL=

POSTGRES_HOST=drawith-postgres
POSTGRES_DB=drawith_test_db
POSTGRES_USER=drawith_test_user
POSTGRES_PASSWORD=drawith-test-password

BETTER_AUTH_SECRET=drawith-test-secret
BETTER_AUTH_URL=http://drawith-app:3000

GRAPHQL_URI=http://drawith-app:3000/api/graphql

TEST_APP_URL=http://drawith-app:3000
