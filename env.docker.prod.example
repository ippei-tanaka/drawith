# Production Docker Environment Variables
# Copy this to .env.docker.prod and fill in real values (don't commit .env.docker.prod)

NODE_ENV=production
POSTGRES_USER=drawith_user
POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_DB=drawith_db
BETTER_AUTH_SECRET=your-secret-string
BETTER_AUTH_URL=https://your-production-domain.com
GRAPHQL_URI=https://your-production-domain.com/api/graphql